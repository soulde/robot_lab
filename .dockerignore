# ignore .git related folders
.git/
**/.git
**/.git/**
.github/
.gitignore
# ignore docs
docs/
# ignore logs
**/logs/
**/runs/
**/output/*
**/outputs/*
**/videos/*
*.tmp
# ignore docker
docker/cluster/exports/
docker/.container.cfg
# ignore local configuration and developer environments
.env
.env.*
**/.venv/
**/venv/
# Keep motion datasets, outputs, and large local artifacts on the host.
artifacts/
datasets/
**/motions/
**/*.npz
**/*.pt
**/*.pth
**/checkpoints/
# ignore tool caches
.ruff_cache/
.mypy_cache/
.cache/
# ignore recordings
recordings/
# ignore __pycache__
**/__pycache__/
**/*.egg-info/
# ignore isaac sim symlink
_isaac_sim?
